# Configure these in Vercel. Use separate, randomly generated tokens.
TV_WEBHOOK_SECRET=
QSTASH_TOKEN=
# Copy the regional service URL from your QStash console.
QSTASH_URL=https://qstash-us-east-1.upstash.io
WORKER_TOKEN=
WORKER_URL=https://your-production-domain/api/v1/analyze-e8f8323f5eecdfce
REDIS_URL=rediss://default:password@your-redis-host:6379
# Also signs expiring report links. Rotating this invalidates existing links.
RESULT_API_TOKEN=
XAI_API_KEY=
# Must support Responses API + server-side Web Search + structured output.
XAI_MODEL=grok-4.7
