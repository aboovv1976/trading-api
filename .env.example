# Configure these in Vercel. Use separate, randomly generated tokens.
TV_WEBHOOK_SECRET=
QSTASH_TOKEN=
# Copy the regional service URL from your QStash console.
QSTASH_URL=https://qstash-us-east-1.upstash.io
WORKER_TOKEN=
WORKER_URL=https://your-production-domain/api/v1/analyze-e8f8323f5eecdfce
REDIS_URL=rediss://default:password@your-redis-host:6379
# Also signs expiring report links. Rotating this invalidates existing links.
RESULT_API_TOKEN=
# TradingView analysis uses the configured Grok bot and its authenticated callback.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=
# Separate bot webhook for WhatsApp conversations (not Meta's callback).
GROK_CHAT_WEBHOOK_URL=
GROK_CHAT_WEBHOOK_KEY=
# Dedicated inbound callback bearer token; distinct from all other tokens.
GROK_CALLBACK_TOKEN=

# WhatsApp callback verification: set the same token in Meta's Verify token field.
WHATSAPP_VERIFY_TOKEN=
# Your Meta developer application's App Secret (not an access or verify token).
WHATSAPP_APP_SECRET=
# Incoming senders allowed to be stored or processed. Empty = deny all.
# Comma-separated international numbers, country code included; optional +.
WHATSAPP_ALLOWED_NUMBERS=
# System-user access token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
# Meta's numeric phone-number ID, not the telephone number.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0

# Refresh older recommendations on /latest TICKER (positive seconds; default one hour).
ANALYSIS_MAX_AGE_SECONDS=3600
